// @see - https://www.electron.build/configuration/configuration
//
// Code signing is opt-in and driven entirely by environment variables, so this
// file needs no edits when certificates are added or removed. Every variable
// below is optional; when absent the corresponding step is simply skipped and
// the build still succeeds (unsigned).
//
//   CSC_LINK + CSC_KEY_PASSWORD          Windows + macOS signing certificate
//                                       (.pfx path, or base64-encoded contents)
//   WIN_CSC_LINK + WIN_CSC_KEY_PASSWORD  Windows-only certificate (optional)
//   APPLE_API_KEY / _KEY_ID / _ISSUER    macOS notarization (recommended)
//   APPLE_ID / _APP_SPECIFIC_PASSWORD / _TEAM_ID   macOS notarization (alt)
//
// The GitHub Actions workflow feeds these from repository secrets - see
// .github/workflows/build-and-release.yml.
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.cuesto.app",
  "asar": true,
  "asarUnpack": [
    "**/node_modules/ffmpeg-static/**/*"
  ],
  "productName": "CUEsto",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}",
    // Enables notarization ONLY when Apple credentials are present in the
    // environment. With none of them set the step is skipped, so an unsigned
    // build still succeeds. See docs/TECHNICAL.md -> Code Signing.
    //
    //   APPLE_API_KEY + APPLE_API_KEY_ID + APPLE_API_ISSUER   (recommended)
    //   APPLE_ID + APPLE_APP_SPECIFIC_PASSWORD + APPLE_TEAM_ID
    //
    // NOTE: Apple REQUIRES the app to be signed before it can notarize, so set
    // CSC_LINK as well when enabling this.
    "notarize": true,
    "protocols": [
      {
        "name": "CUEsto Protocol",
        "schemes": ["cuesto"]
      }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "${productName}-Windows-${version}-${arch}.${ext}",
    "protocols": [
      {
        "name": "CUEsto Protocol",
        "schemes": ["cuesto"]
      }
    ]
  },
  "fileAssociations": [
    {
      "ext": "cue",
      "name": "CUE Sheet",
      "description": "CUE audio sheet",
      "icon": "build/icon.ico"
    }
  ],
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "installer.ico",
    "installerHeader": "installerHeader.bmp",
    "installerSidebar": "installerSidebar.bmp",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": true
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "build/icon.png",
    "artifactName": "${productName}-Linux-${version}.${ext}",
    "protocols": [
      {
        "name": "CUEsto Protocol",
        "schemes": ["cuesto"]
      }
    ]
  },
  "publish": [
    {
      "provider": "github",
      "owner": "djnizzi",
      "repo": "cuesto"
    }
  ]
}
